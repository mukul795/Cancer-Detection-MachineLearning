<!DOCTYPE html>
<html>
<head>
  <link rel="stylesheet" href="index.css">
    <title>Cancer Detection</title>
</head>
<body>
    <h2>Check for Cancer</h2>
    <form method="POST" action="/predict">
        <label>Mean Radius:</label>
        <input type="number" step="any" name="mean_radius" required><br>

        <label>Mean Texture:</label>
        <input type="number" step="any" name="mean_texture" required><br>

        <label>Mean Perimeter:</label>
        <input type="number" step="any" name="mean_perimeter" required><br>

        <label>Mean Area:</label>
        <input type="number" step="any" name="mean_area" required><br>

        <label>Mean Smoothness:</label>
        <input type="number" step="any" name="mean_smoothness" required><br>

        <input type="submit" value="Predict">
    </form>

   
</body>
</html>
